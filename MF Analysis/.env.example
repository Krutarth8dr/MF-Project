# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored and must NEVER be committed.

# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE_ROLE key — required by the upload script to write to
# fund_holdings (it bypasses Row Level Security).
# WARNING: this key has full database access. Keep it ONLY in this server-side
# .env. NEVER commit it and NEVER put it in any NEXT_PUBLIC_* / frontend var.
SUPABASE_KEY=your-service-role-key-here
