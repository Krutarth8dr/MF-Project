# ── Secrets ──────────────────────────────────────────────
# Never commit credentials. Use .env.example as the template.
.env
.env.*
!.env.example

# ── Python virtual environment ───────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ── Generated / bulky data (regenerated by the pipeline) ──
# Raw source files and pipeline outputs are large and reproducible.
# Comment these out if you intentionally want them version-controlled.
01_raw_files/
03_clean_data/
04_matrix_output/
05_matrix/
*.csv

# ── OS / editor cruft ────────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
~$*.xlsx
